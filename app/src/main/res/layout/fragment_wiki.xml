<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.WikiFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background_color"
        tools:context=".fragments.WikiFragment">

        <!-- Поисковая строка -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:padding="10dp"
            android:clipToOutline="true"
            android:elevation="4dp"
            android:backgroundTint="@color/bars_color"
            android:background="@drawable/bg_style_rounded"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="16dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_search"
                android:layout_gravity="center_vertical"
                android:padding="8dp"/>

            <EditText
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:hint="Введите артикул"
                android:backgroundTint="@color/bars_color"
                android:background="@drawable/bg_style_rounded"
                android:padding="8dp"/>

        </LinearLayout>

        <!-- Содержание (само wiki) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="16dp"
            android:backgroundTint="@color/content_color"
            android:background="@drawable/bg_style_rounded"
            android:layout_marginHorizontal="16dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>