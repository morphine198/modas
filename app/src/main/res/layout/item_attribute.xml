<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_style_rounded"
    android:elevation="2dp">

    <TextView
        android:id="@+id/tvAttributeName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Сила (STR)"
        android:textSize="16sp"
        android:textColor="?attr/colorText"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAttributeValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="16"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="?attr/colorText"
        android:layout_marginEnd="12dp" />

    <TextView
        android:id="@+id/tvAttributeModifier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="(+3)"
        android:textSize="18sp"
        android:textColor="@android:color/holo_green_dark"
        android:background="@drawable/bg_modifier"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:layout_marginEnd="8dp" />

    <ImageView
        android:id="@+id/ivEdit"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_edit"
        android:padding="4dp"
        android:tint="?attr/colorIcon" />

</LinearLayout>