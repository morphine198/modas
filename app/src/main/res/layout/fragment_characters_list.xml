<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    tools:context=".fragments.CharactersListFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?attr/colorBackground"
        tools:context=".fragments.CharactersListFragment">

        <!-- Поисковая строка -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:orientation="horizontal"
                android:clipToOutline="true"
                android:elevation="4dp"
                android:backgroundTint="?attr/colorBars"
                android:background="@drawable/bg_style_rounded">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_search"
                    android:layout_gravity="center_vertical"
                    android:padding="12dp"
                    android:tint="?attr/colorIcon"/>

                <AutoCompleteTextView
                    android:id="@+id/searchAutoCompleteText"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_gravity="center_vertical"
                    android:hint="Введите имя персонажа..."
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:background="@null"
                    android:padding="8dp"
                    android:textColor="?attr/colorText"
                    android:textColorHint="?attr/colorHint"
                    android:completionThreshold="0"/>

                <!-- Кнопка очистки текста -->
                <ImageView
                    android:id="@+id/clearButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_close"
                    android:layout_gravity="center_vertical"
                    android:padding="12dp"
                    android:tint="?attr/colorIcon"
                    android:visibility="gone"/>

            </LinearLayout>

            <!-- Кнопка очистки истории -->
            <TextView
                android:id="@+id/clearHistoryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Очистить историю"
                android:textSize="12sp"
                android:textColor="@android:color/holo_red_dark"
                android:padding="8dp"
                android:layout_marginTop="4dp"
                android:layout_gravity="end"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- ProgressBar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingVertical="32dp"
            android:visibility="gone" />

        <!-- Placeholder для пустого состояния или ошибки -->
        <LinearLayout
            android:id="@+id/placeholderContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/placeholderIcon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_search_empty"
                android:layout_marginBottom="16dp"
                android:tint="?attr/colorIcon"/>

            <TextView
                android:id="@+id/placeholderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ничего не найдено"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?attr/colorText"
                android:textAlignment="center"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/placeholderMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Попробуйте изменить поисковый запрос"
                android:textSize="14sp"
                android:textColor="?attr/colorHint"
                android:textAlignment="center"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/retryButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Обновить"
                android:textColor="?attr/colorButtonText"
                android:backgroundTint="?attr/colorButton"
                android:visibility="gone"
                style="@style/Widget.AppCompat.Button.Colored"/>

        </LinearLayout>

        <!-- Список персонажей -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingVertical="8dp"
            android:paddingHorizontal="16dp"
            android:backgroundTint="?attr/colorContent"
            android:background="@drawable/bg_style_rounded"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"/>

        <!-- Кнопка добавления персонажа -->
        <Button
            android:id="@+id/btnAddCharacter"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="+ Добавить персонажа"
            android:textColor="?attr/colorButtonText"
            android:backgroundTint="?attr/colorButton"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>