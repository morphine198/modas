<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_color"
    tools:context=".fragments.CharacterStatsFragment">

    <!-- Заголовок с именем персонажа -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:backgroundTint="@color/content_color"
        android:background="@drawable/bg_style_rounded"
        android:layout_marginHorizontal="16dp"
        android:layout_margin="16dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tvCharacterName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Имя персонажа"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/white"
            android:alpha="0.3"
            android:layout_marginVertical="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/tvLevel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Уровень: 1"
                android:textSize="16sp"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/tvExperience"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Опыт: 0 XP"
                android:textSize="16sp"
                android:textColor="@android:color/white" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvProficiencyBonus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Бонус мастерства: +2"
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:alpha="0.8" />

    </LinearLayout>

    <!-- Заголовок атрибутов -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ХАРАКТЕРИСТИКИ"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <!-- Список атрибутов -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAttributes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:backgroundTint="@color/content_color"
        android:background="@drawable/bg_style_rounded"
        android:layout_marginHorizontal="16dp" />

    <!-- Кнопки навигации -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="НАЗАД"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:backgroundTint="@color/content_color"
            android:background="@drawable/bg_style_rounded"
            android:layout_marginHorizontal="16dp"
            style="@style/Widget.AppCompat.Button.Borderless" />

        <Button
            android:id="@+id/btnForward"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="ВПЕРЁД"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:backgroundTint="@color/content_color"
            android:background="@drawable/bg_style_rounded"
            android:layout_marginHorizontal="16dp"
            style="@style/Widget.AppCompat.Button.Borderless" />

    </LinearLayout>

</LinearLayout>