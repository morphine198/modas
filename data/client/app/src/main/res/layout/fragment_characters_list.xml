<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.view.fragments.CharactersListFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background_color"
        tools:context=".presentation.view.fragments.CharactersListFragment">

        <!-- Поисковая строка -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:padding="10dp"
            android:clipToOutline="true"
            android:elevation="4dp"
            android:backgroundTint="@color/bars_color"
            android:background="@drawable/bg_style_rounded"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="16dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_search"
                android:layout_gravity="center_vertical"
                android:padding="8dp"/>

            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:hint="Введите имя персонажа"
                android:backgroundTint="@color/bars_color"
                android:background="@drawable/bg_style_rounded"
                android:padding="8dp"/>

            <!-- Кнопка очистки (по умолчанию скрыта) -->
            <ImageView
                android:id="@+id/clearButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_arrow_left_spaced"
                android:layout_gravity="center_vertical"
                android:padding="8dp"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- Список -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingVertical="16dp"
            android:paddingHorizontal="8dp"
            android:backgroundTint="@color/content_color"
            android:background="@drawable/bg_style_rounded"
            android:layout_marginHorizontal="16dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>